# Déploiement Docker Compose uniquement : PostgreSQL est alors fourni par ce Compose.
# Pour Neon + Render, consulter la section « Déploiement gratuit : Neon et Render » du README.
POSTGRES_DB=devhub
POSTGRES_USER=devhub
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Générer une valeur avec : openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_TOKEN_LIFETIME=PT12H

# Compte créé au premier démarrage. Laisser les deux valeurs vides pour ne pas le créer.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Origine publique exacte du frontend, sans slash final.
CORS_ALLOWED_ORIGINS=https://app.example.com
APP_PORT=8080
